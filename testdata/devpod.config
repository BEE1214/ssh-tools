# DevPod Start opcuaclientpython.devpod
Host opcuaclientpython.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  User root
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/usr/bin/devpod-cli" ssh --stdio --context default --user root opcuaclientpython
# DevPod End opcuaclientpython.devpod

Host emil
  HostName 10.0.0.1
  User adam
  IdentityFile ~/.ssh/id_ed25519